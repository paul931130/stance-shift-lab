# Copy to .env.research, or run: .\research.ps1 setup
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_KEEP_ALIVE=-1
# ./research.sh only: true runs Ollama as a container next to the service
# (compose.ollama.yaml), gpu also gives it an NVIDIA GPU. Leave empty to use
# an Ollama installed on this computer, GPUtw, or a cloud API.
RESEARCH_OLLAMA_CONTAINER=
# Formal research uses a 14B-or-larger model by default. The canary-qualified
# qwen3:8b is the only formal sub-14B exception; other smaller models require
# the explicit smoke-test checkbox/API override.
RESEARCH_MODEL=ollama/qwen3:14b
RESEARCH_PARALLEL_WORKERS=4
# Set true only for a no-key UI walkthrough. It uses fixed synthetic data and
# never calls an external model; its output is not formal research evidence.
RESEARCH_DEMO_MODE=false
RESEARCH_MODEL_TIMEOUT_SECONDS=240
RESEARCH_MODEL_CONTEXT_LENGTH=8192

# Local is the safe default. Production compose forces remote mode.
RESEARCH_REMOTE=false
RESEARCH_ACCESS_KEY=
RESEARCH_ALLOWED_HOSTS=localhost,127.0.0.1
RESEARCH_PUBLIC_ORIGIN=
# Reverse-proxy address(es) whose X-Forwarded-For is trusted for login rate limiting.
# Leave empty unless a proxy such as Caddy sits in front of the service.
RESEARCH_TRUSTED_PROXIES=

# Log verbosity for research_service loggers (DEBUG/INFO/WARNING/ERROR).
RESEARCH_LOG_LEVEL=INFO

# Optional data sources. Missing evidence is reported and never simulated.
SEC_USER_AGENT=
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
# A locally accumulated NEWS_SENTIMENT archive (see scripts/alphavantage_news_fetch.py).
# Checked before the live API call above, so a cache hit costs zero quota.
ALPHA_VANTAGE_NEWS_PATH=/app/research-inputs/alphavantage_news.csv
FNSPID_NEWS_PATH=/app/research-inputs/Stock_news.csv
# FinBERT is installed and cached locally on first use; HF_TOKEN is not needed.
FINBERT_MODEL=ProsusAI/finbert
FINBERT_REVISION=4556d13015211d73dccd3fdd39d39232506f3e43

# Optional cloud model providers.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional GPUtw integration (docs/gputw-integration.md). GPUtw bills a GPU
# container while it is RUNNING. Start instances in GPUtw's dashboard; this
# service never starts one.
GPUTW_API_URL=https://gputw.ai
# Status and resources; with the instances:manage scope it also lets the service
# stop an idle instance (see RESEARCH_GPUTW_AUTOSTOP_MINUTES).
GPUTW_API_KEY=
GPUTW_INSTANCE_ID=
# e.g. https://11434-<instance-id>.gputw.ai
GPUTW_OLLAMA_BASE_URL=
GPUTW_OLLAMA_API_KEY=
# Password of the "unlisted" 11434 port, if you protect it that way.
GPUTW_OLLAMA_PASSWORD=
# Optional separate instances:manage key for auto-stop (else GPUTW_API_KEY is
# used). The instance is stopped after running this many minutes with an empty
# research queue (0 = off).
GPUTW_MANAGE_API_KEY=
RESEARCH_GPUTW_AUTOSTOP_MINUTES=15
# Calls of one case sent to a GPU Ollama at once (1 = sequential, as in the
# published runs). Needs OLLAMA_NUM_PARALLEL >= this on the Ollama server.
RESEARCH_OLLAMA_PARALLEL=1

# Copy to .env.research, or run: .\research.ps1 setup
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_KEEP_ALIVE=-1
# Formal research uses a 14B-or-larger model. Smaller models require the
# explicit smoke-test checkbox/API override.
RESEARCH_MODEL=ollama/qwen3:14b
RESEARCH_PARALLEL_WORKERS=4

# Local is the safe default. Production compose forces remote mode.
RESEARCH_REMOTE=false
RESEARCH_ACCESS_KEY=
RESEARCH_ALLOWED_HOSTS=localhost,127.0.0.1
RESEARCH_PUBLIC_ORIGIN=

# Log verbosity for research_service loggers (DEBUG/INFO/WARNING/ERROR).
RESEARCH_LOG_LEVEL=INFO

# Optional data sources. Missing evidence is reported and never simulated.
SEC_USER_AGENT=
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
# A locally accumulated NEWS_SENTIMENT archive (see scripts/alphavantage_news_fetch.py).
# Checked before the live API call above, so a cache hit costs zero quota.
ALPHA_VANTAGE_NEWS_PATH=/app/research-inputs/alphavantage_news.csv
FNSPID_NEWS_PATH=/app/research-inputs/Stock_news.csv
# FinBERT is installed and cached locally on first use; HF_TOKEN is not needed.
FINBERT_MODEL=ProsusAI/finbert
FINBERT_REVISION=4556d13015211d73dccd3fdd39d39232506f3e43

# Optional cloud model providers.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional GPUtw integration. GPUtw manages a billable GPU container; this
# service only reads status/resources. Deploy or stop instances in GPUtw's
# dashboard. For an Ollama template, set its protected endpoint here.
GPUTW_API_URL=https://gputw.ai
GPUTW_API_KEY=
GPUTW_INSTANCE_ID=
GPUTW_OLLAMA_BASE_URL=
GPUTW_OLLAMA_API_KEY=

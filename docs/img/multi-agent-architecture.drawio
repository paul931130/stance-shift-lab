<mxfile host="app.diagrams.net"><diagram id="multi-agent" name="多代理決策流程"><mxGraphModel dx="1400" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1400" background="#F7F5F0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Stance Shift Lab：多代理決策流程（單一案例）" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1F2A37;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="900" height="36" as="geometry"/></mxCell><mxCell id="g1" value="1 · 資料來源" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FBFAF6;strokeColor=#C9C4B5;strokeWidth=1;dashed=1;dashPattern=6 4;fontColor=#5B6673;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1320" height="130" as="geometry"/></mxCell><mxCell id="d1" value='&lt;b&gt;Yahoo 價格&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#5B6673"&gt;技術面資料&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9C4B5;strokeWidth=2;fontColor=#1F2A37;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="g1"><mxGeometry x="20" y="44" width="240" height="70" as="geometry"/></mxCell><mxCell id="d2" value='&lt;b&gt;SEC XBRL&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#5B6673"&gt;財報數字&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9C4B5;strokeWidth=2;fontColor=#1F2A37;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="g1"><mxGeometry x="280" y="44" width="240" height="70" as="geometry"/></mxCell><mxCell id="d3" value='&lt;b&gt;新聞&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#5B6673"&gt;Alpha Vantage · FNSPID&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9C4B5;strokeWidth=2;fontColor=#1F2A37;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="g1"><mxGeometry x="540" y="44" width="240" height="70" as="geometry"/></mxCell><mxCell id="d4" value='&lt;b&gt;FinBERT&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#5B6673"&gt;本機情緒分數&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9C4B5;strokeWidth=2;fontColor=#1F2A37;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="g1"><mxGeometry x="800" y="44" width="240" height="70" as="geometry"/></mxCell><mxCell id="d5" value='&lt;b&gt;FRED / ALFRED&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#5B6673"&gt;總體資料&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9C4B5;strokeWidth=2;fontColor=#1F2A37;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="g1"><mxGeometry x="1060" y="44" width="240" height="70" as="geometry"/></mxCell><mxCell id="coord" value='&lt;b&gt;2 · Coordinator：建立證據快照&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#5B6673"&gt;依分析日切出時間邊界內的證據，四個領域各自輸入（不使用未來資料）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontColor=#1F2A37;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="290" y="250" width="820" height="76" as="geometry"/></mxCell><mxCell id="g3" value="3 · 研究 Agent（只摘要證據、不給投資建議、須引用證據編號）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FBFAF6;strokeColor=#C9C4B5;strokeWidth=1;dashed=1;dashPattern=6 4;fontColor=#5B6673;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="386" width="1320" height="160" as="geometry"/></mxCell><mxCell id="r1" value='&lt;b&gt;技術面 Agent&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#5B6673"&gt;LLM 摘要價格證據&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#1F2A37;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="g3"><mxGeometry x="30" y="48" width="300" height="90" as="geometry"/></mxCell><mxCell id="r2" value='&lt;b&gt;基本面 Agent&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#5B6673"&gt;確定性擷取（非 LLM），SEC 數字逐字保留&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontColor=#1F2A37;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="g3"><mxGeometry x="350" y="48" width="300" height="90" as="geometry"/></mxCell><mxCell id="r3" value='&lt;b&gt;情緒面 Agent&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#5B6673"&gt;LLM 摘要新聞與 FinBERT 分數&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#1F2A37;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="g3"><mxGeometry x="670" y="48" width="300" height="90" as="geometry"/></mxCell><mxCell id="r4" value='&lt;b&gt;總體 Agent&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#5B6673"&gt;LLM 摘要總體資料&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#1F2A37;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="g3"><mxGeometry x="990" y="48" width="300" height="90" as="geometry"/></mxCell><mxCell id="report" value='&lt;b&gt;4 · 中性報告（Neutral Report）&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#5B6673"&gt;鎖定並計算雜湊；A / B / C / D 四組看到同一份證據&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9C4B5;strokeWidth=2;fontColor=#1F2A37;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="290" y="606" width="820" height="76" as="geometry"/></mxCell><mxCell id="g5" value="5 · 決策組別（每案例共 22 次模型呼叫 = 1 + 7 + 7 + 7）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FBFAF6;strokeColor=#C9C4B5;strokeWidth=1;dashed=1;dashPattern=6 4;fontColor=#5B6673;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="742" width="1320" height="190" as="geometry"/></mxCell><mxCell id="a1" value='&lt;b&gt;A　單一決策&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#5B6673"&gt;1 次呼叫。基準組：一次直接判斷&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9C4B5;strokeWidth=2;fontColor=#1F2A37;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="g5"><mxGeometry x="30" y="48" width="300" height="120" as="geometry"/></mxCell><mxCell id="a2" value='&lt;b&gt;B　自我一致性投票&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#5B6673"&gt;7 次取樣（溫度 0.8）。與 C / D 算力相當的對照&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9C4B5;strokeWidth=2;fontColor=#1F2A37;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="g5"><mxGeometry x="350" y="48" width="300" height="120" as="geometry"/></mxCell><mxCell id="a3" value='&lt;b&gt;C　多空辯論&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#5B6673"&gt;多頭 / 空頭 3 輪辯論 + 裁決者，共 7 次呼叫&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9C4B5;strokeWidth=2;fontColor=#1F2A37;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="g5"><mxGeometry x="670" y="48" width="300" height="120" as="geometry"/></mxCell><mxCell id="a4" value='&lt;b&gt;D　立場交換（處理組）&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#5B6673"&gt;同 C，但第 2 輪互換立場；互換輪不看對手歷史，共 7 次呼叫&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF7ED;strokeColor=#B45309;strokeWidth=2;fontColor=#1F2A37;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="g5"><mxGeometry x="990" y="48" width="300" height="120" as="geometry"/></mxCell><mxCell id="gate" value='&lt;b&gt;6 · Gatekeeper 閘門&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#C9D3E0"&gt;檢查領域覆蓋、引用通過率 ≥ 0.80、年化波動率 ≤ 0.80、歷史準確度（警示）；預期報酬落在 ±0.5σ 中性帶 → Hold，否則 Buy / Sell；資料不足依政策 NoTrade&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#14213D;strokeColor=#14213D;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="992" width="1320" height="96" as="geometry"/></mxCell><mxCell id="bt" value='&lt;b&gt;7 · 回測與統計&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#5B6673"&gt;持有期 30 / 60 / 90 天（主要終點 60 天）· 成本模型 zero 與 Corwin-Schultz · block bootstrap 比較 A / B / C / D&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9C4B5;strokeWidth=2;fontColor=#1F2A37;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="1148" width="1320" height="76" as="geometry"/></mxCell><mxCell id="foot" value="僅供研究；不執行交易、不構成投資建議" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontColor=#5B6673;" vertex="1" parent="1"><mxGeometry x="860" y="1238" width="500" height="22" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#5B6673;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#5B6673;labelBackgroundColor=#F7F5F0;" edge="1" parent="1" source="g1" target="coord"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#5B6673;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#5B6673;labelBackgroundColor=#F7F5F0;" edge="1" parent="1" source="coord" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#5B6673;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#5B6673;labelBackgroundColor=#F7F5F0;" edge="1" parent="1" source="g3" target="report"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#5B6673;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#5B6673;labelBackgroundColor=#F7F5F0;" edge="1" parent="1" source="report" target="g5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#5B6673;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#5B6673;labelBackgroundColor=#F7F5F0;" edge="1" parent="1" source="g5" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#5B6673;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#5B6673;labelBackgroundColor=#F7F5F0;" edge="1" parent="1" source="gate" target="bt"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# misc
.DS_Store
*.pem

# env files (can opt-in for committing if needed)
.env*
!.env.example

# python
.venv/
.native-venv/
__pycache__/
*.py[cod]
/.pytest_cache/
/.ruff_cache/

# research runtime data and artifacts (persist in the Docker volume instead)
/research-data/
/research-data-*/
/backups/
/_stance_shift_backups/
/stance-shift-backup-*.zip
/research-*.zip
/release/
/deliverables/
/research-inputs/*.csv
/research-inputs/*.jsonl
/research-inputs/*.json
/outputs/
/work/

# Python packaging build output
build/
*.egg-info/

# LaTeX build output and rendered report copies
/report/*.aux
/report/*.bbl
/report/*.blg
/report/*.fdb_latexmk
/report/*.fls
/report/*.log
/report/*.xdv
/report/*.pdf
/report/revisions/**/*.pdf
/report/revisions/**/*.png

# local scratch and one-off exports
/tmp/
/*.zip
/research-inputs/*.before-backfill-*
